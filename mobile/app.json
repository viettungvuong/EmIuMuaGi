{
  "expo": {
    "name": "EmIuMuaGi",
    "slug": "emiumuagi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.viettungvuong.emiumuagi"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#fff1f2",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.viettungvuong.emiumuagi"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Cho phép EmIuMuaGi chọn ảnh và video để đính kèm vào món đồ."
        }
      ]
    ],
    "scheme": "emiumuagi",
    "backgroundColor": "#fff1f2"
  }
}
