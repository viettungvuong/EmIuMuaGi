DATABASE_URL=
JWT_SECRET=
PORT=
# The user service, when not on its usual port on this machine (default http://localhost:8001)
USER_SERVICE_URL=
# Binned items are deleted for good at PURGE_HOUR (default 3) after PURGE_AFTER_DAYS (default 30)
PURGE_HOUR=
PURGE_AFTER_DAYS=
# The notification digest's hours, Vietnam time (default 0,9,17)
NOTIFY_HOURS=
# Only needed once "Enhanced push security" is on for the project at expo.dev
EXPO_ACCESS_TOKEN=
