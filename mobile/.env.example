# Copy to .env (git-ignored); Expo reads it on start.
# Restart with `npx expo start --clear` after changing it.

# The API gateway the app talks to: the VPS. Leave it empty (EXPO_PUBLIC_API_URL=)
# to use the gateway on port 8000 of the computer running `npx expo start` instead.
EXPO_PUBLIC_API_URL=http://103.126.162.123

# Where the web app lives, for partner invite links. Defaults to EXPO_PUBLIC_API_URL.
EXPO_PUBLIC_WEB_URL=
