DATABASE_URL=
JWT_SECRET=
PORT=
# The other services, when not on their usual ports on this machine
# (defaults http://localhost:8001 and http://localhost:8004)
USER_SERVICE_URL=
AI_SERVICE_URL=
# Binned items are deleted for good at PURGE_HOUR (default 3) after PURGE_AFTER_DAYS (default 30)
PURGE_HOUR=
PURGE_AFTER_DAYS=
# The notification digest's hours, Vietnam time (default 0,9,17)
NOTIFY_HOURS=
# Only needed once "Enhanced push security" is on for the project at expo.dev
EXPO_ACCESS_TOKEN=
