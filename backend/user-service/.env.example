DATABASE_URL="host=localhost user=postgres password=postgres dbname=emiumuagi_user port=5432 sslmode=disable TimeZone=Asia/Ho_Chi_Minh"

# Secrets that sign the access and refresh tokens: any long random strings,
# e.g. from `openssl rand -hex 32`. Use a different one for each.
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too

# Port to listen on. Defaults to 8001, which the API gateway expects.
PORT=

# Redis that holds signup OTPs. Defaults to redis://localhost:6379/0.
# With a password: redis://:password@host:6379/0
REDIS_URL=

# SMTP server that emails the OTPs (port 587, STARTTLS).
# For Gmail: turn on 2-Step Verification and use an App Password
# (myaccount.google.com/apppasswords), not the normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=you@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_FROM=EmIuMuaGi <you@gmail.com>
