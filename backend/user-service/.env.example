# Where the item service listens, for deleting an account's items (default http://localhost:8002)
ITEM_SERVICE_URL=
# Sign in with Google / Apple / Facebook (POST /api/auth/oauth). A provider without
# its ids answers "not set up". GOOGLE_CLIENT_IDS: comma-separated OAuth client ids
# the ID token may be for (the Web client's, which the apps also use, and iOS's)
GOOGLE_CLIENT_IDS=
# Apple: the app's bundle id (default com.viettungvuong.emiumuagi)
APPLE_AUDIENCES=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
