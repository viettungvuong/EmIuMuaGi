EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_WEB_URL=

# Signing in with Google / Facebook (Apple needs nothing here). A provider whose
# ids are missing gets no button. Changing these needs a new native build.
# Google Cloud console > Credentials: the Web client's id (the token is for it,
# also on Android) and the iOS client's id
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# developers.facebook.com > your app > Settings > Basic / Advanced
EXPO_PUBLIC_FACEBOOK_APP_ID=
EXPO_PUBLIC_FACEBOOK_CLIENT_TOKEN=
