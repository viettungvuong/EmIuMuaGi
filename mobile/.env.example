# Copy to .env.local and fill in. Without these, development talks to the
# gateway on port 8000 of the computer running `npx expo start`.

# The API gateway, e.g. https://your-domain.com
EXPO_PUBLIC_API_URL=

# Where the web app lives, for partner invite links. Defaults to EXPO_PUBLIC_API_URL.
EXPO_PUBLIC_WEB_URL=
